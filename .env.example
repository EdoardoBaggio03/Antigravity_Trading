# ==========================================
# AI CAPITAL - CONFIGURAZIONE (.env.example)
# ==========================================

# Google AI Studio (Free Tier SDK google-genai)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
# Modello predefinito gratuito: gemini-3.8-flash (modificabile in gemini-4-argon)
GEMINI_MODEL=gemini-3.8-flash

# Alpaca Paper Trading (BLOCCATO SU PAPER API)
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Telegram Notifier
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Parametri Operativi e Fuso Orario
TIMEZONE=Europe/Rome
MAX_SINGLE_ASSET_WEIGHT=0.20
